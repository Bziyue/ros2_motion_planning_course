Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 239; 246; 247
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 22
      Color: 165; 188; 195
      Alpha: 0.45
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulation world
      Enabled: true
      Topic:
        Value: /visualization/world
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot and trail
      Enabled: true
      Topic:
        Value: /visualization/robot
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Axes
      Name: Body orientation
      Enabled: true
      Reference Frame: base_link
      Length: 0.6
      Radius: 0.025
    - Class: rviz_default_plugins/MarkerArray
      Name: CPU lidar beams
      Enabled: true
      Topic:
        Value: /visualization/lidar
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Measured scan points
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 210; 67; 29
      Position Transformer: XYZ
      Decay Time: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic: /command/pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: <Fixed Frame>
      Scale: 29
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1100
  Height: 780
